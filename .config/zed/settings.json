{
  "ssh_connections": [
    {
      "host": "hyperminimal",
      "username": "simon",
      "projects": [
        {
          "paths": ["~/dev/monoscope/monoscope"]
        }
      ]
    }
  ],
  "assistant": {
    "default_profile": "ask",
    "profiles": {
      "code-writer": {
        "name": "Code Writer",
        "tools": {
          "bash": true,
          "copy-path": true,
          "create-file": true,
          "delete-path": true,
          "diagnostics": true,
          "find-replace-file": true,
          "edit-files": false,
          "fetch": true,
          "list-directory": true,
          "move-path": true,
          "now": true,
          "path-search": true,
          "read-file": true,
          "regex-search": true,
          "thinking": true
        },
        "context_servers": {}
      }
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-3-7-sonnet-latest"
    },
    "version": "2"
  },
  "languages": {
    "TSX": {
      "show_edit_predictions": false
    },
    "TypeScript": {
      "show_edit_predictions": false
    },
    "Go": {
      "show_edit_predictions": false
    }
  },
  "theme": "Tokyo Night",
  "base_keymap": "VSCode",
  "vim_mode": true,
  "ui_font_size": 19,
  "buffer_font_size": 19,
  "ui_font_family": "JetBrainsMonoNL Nerd Font",
  "buffer_font_family": "JetBrainsMonoNL Nerd Font",
  "buffer_line_height": "comfortable",
  "vertical_scroll_margin": 5,
  "relative_line_numbers": true,
  "preferred_line_length": 120,
  "seed_search_query_from_cursor": "never",
  "double_click_in_multibuffer": "open",
  "chat_panel": {
    "button": "never"
  },
  "show_signature_help_after_edits": false,
  "project_panel": {
    "dock": "right"
  },
  "terminal": {
    "dock": "bottom"
  },
  "calls": {
    "share_on_join": false
  }
}
